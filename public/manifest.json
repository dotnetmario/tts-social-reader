{
    "manifest_version": 3,
    "name": "tts-social-reader",
    "version": "1.0",
    "description": "TTS extension that reads posts/comments/articles on supported sites",
    "permissions": [
        "storage",
        "activeTab",
        "identity"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "128": "icons/icon128.png"
    }
}