{
    "manifest_version": 3,
    "name": "tts-social-reader",
    "version": "1.0",
    "description": "TTS extension that reads posts/comments/articles on supported sites",
    "permissions": [
        "storage",
        "activeTab",
        "identity",
        "scripting",
        "offscreen"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "pages/offscreen.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}